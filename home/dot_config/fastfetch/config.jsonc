{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Catppuccin Mocha: blue 137;180;250  mauve 203;166;247  peach 250;179;135
  //                   green 166;227;161  teal 148;226;213  overlay 108;112;134
  "logo": {
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "38;2;203;166;247",
      "keys": "38;2;137;180;250",
      "output": "38;2;205;214;244"
    },
    "key": { "width": 15 },
    "bar": {
      "char": { "elapsed": "■", "total": "■" },
      "border": { "left": "", "right": "" },
      "width": 12
    },
    "percent": {
      "type": ["num", "bar"],
      "color": { "green": "38;2;166;227;161", "yellow": "38;2;249;226;175", "red": "38;2;243;139;168" }
    }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}\u001b[38;2;108;112;134m@\u001b[0m{host-name-colored}" },
    "break",

    { "type": "custom", "format": "\u001b[38;2;137;180;250m╭─\u001b[1m system \u001b[0m\u001b[38;2;137;180;250m──────────────────────────────" },
    { "type": "os",       "key": "│ \uf179 os",      "keyColor": "38;2;137;180;250" },
    { "type": "host",     "key": "│ 󰇄 host",    "keyColor": "38;2;137;180;250" },
    { "type": "kernel",   "key": "│ \uf013 kernel",  "keyColor": "38;2;137;180;250" },
    { "type": "uptime",   "key": "│ 󰅐 uptime",  "keyColor": "38;2;137;180;250" },
    { "type": "packages", "key": "│ 󰏖 packages","keyColor": "38;2;137;180;250" },
    { "type": "shell",    "key": "│ \uf489 shell",   "keyColor": "38;2;137;180;250" },
    { "type": "terminal", "key": "│ \uf120 terminal","keyColor": "38;2;137;180;250" },
    { "type": "custom", "format": "\u001b[38;2;137;180;250m╰────────────────────────────────────────\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;203;166;247m╭─\u001b[1m hardware \u001b[0m\u001b[38;2;203;166;247m────────────────────────────" },
    { "type": "cpu",    "key": "│ \uf4bc cpu",    "keyColor": "38;2;203;166;247", "temp": true },
    { "type": "gpu",    "key": "│ 󰢮 gpu",    "keyColor": "38;2;203;166;247", "temp": true },
    { "type": "memory", "key": "│ \uefc5 memory", "keyColor": "38;2;203;166;247" },
    { "type": "swap",   "key": "│ 󰓡 swap",   "keyColor": "38;2;203;166;247" },
    { "type": "custom", "format": "\u001b[38;2;203;166;247m╰────────────────────────────────────────\u001b[0m" },

    { "type": "custom", "format": "\u001b[38;2;250;179;135m╭─\u001b[1m storage & net \u001b[0m\u001b[38;2;250;179;135m───────────────────────" },
    { "type": "disk",    "key": "│ 󰋊 disk",    "keyColor": "38;2;250;179;135", "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})" },
    { "type": "localip", "key": "│ 󰩟 local ip","keyColor": "38;2;250;179;135" },
    { "type": "custom", "format": "\u001b[38;2;250;179;135m╰────────────────────────────────────────\u001b[0m" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
